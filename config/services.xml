<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <imports>
        <import resource="services/**" />
    </imports>

    <services>
        <service id="sarissaops_enviatodo.provider_map" class="SarissaOps\SyliusEnviatodoPlugin\Component\Shipping\ProviderMap">
            <argument>%sarissa_ops_sylius_enviatodo.provider_map%</argument>
        </service>

        <service id="sarissaops_enviatodo.quote_api" class="SarissaOps\Enviatodo\Api\QuoteApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="quote" />
        </service>

        <service id="sarissaops_enviatodo.zip_code_api" class="SarissaOps\Enviatodo\Api\ZipCodeApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="zipCode" />
        </service>

        <service id="sarissaops_enviatodo.component_calculator" class="SarissaOps\SyliusEnviatodoPlugin\Component\Shipping\Calculator\EnviatodoCalculator">
            <argument type="service" id="sarissaops_enviatodo.quote_api" />
        </service>

        <service id="sarissaops_enviatodo.shipping_calculator" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoShippingCalculator">
            <argument type="service" id="sarissaops_enviatodo.component_calculator" />
            <argument type="service" id="sarissaops_enviatodo.provider_map" />
            <tag name="sylius.shipping_calculator" calculator="enviatodo" label="Enviatodo (live rates)" />
        </service>

        <service id="sarissaops_enviatodo.validator.method_available" class="SarissaOps\SyliusEnviatodoPlugin\Validator\Constraints\EnviatodoMethodAvailableValidator">
            <argument type="service" id="sarissaops_enviatodo.zip_code_api" />
            <argument type="service" id="sarissaops_enviatodo.provider_map" />
            <tag name="validator.constraint_validator" />
        </service>

        <service id="sarissaops_enviatodo.order_api" class="SarissaOps\Enviatodo\Api\OrderApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="order" />
        </service>

        <service id="sarissaops_enviatodo.balance_api" class="SarissaOps\Enviatodo\Api\BalanceApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="balance" />
        </service>

        <service id="sarissaops_enviatodo.repository.shipment" class="SarissaOps\SyliusEnviatodoPlugin\Repository\EnviatodoShipmentRepository">
            <argument type="service" id="doctrine" />
        </service>

        <service id="sarissaops_enviatodo.order_manager" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoOrderManager">
            <argument type="service" id="sarissaops_enviatodo.order_api" />
            <argument type="service" id="sarissaops_enviatodo.balance_api" />
            <argument type="service" id="sarissaops_enviatodo.provider_map" />
            <argument type="service" id="doctrine" />
            <argument type="service" id="logger" />
            <argument>%sarissa_ops_sylius_enviatodo.insurance%</argument>
        </service>

        <service id="sarissaops_enviatodo.listener.order_paid" class="SarissaOps\SyliusEnviatodoPlugin\EventListener\OrderPaidListener">
            <argument type="service" id="sarissaops_enviatodo.order_manager" />
            <argument type="service" id="sarissaops_enviatodo.provider_map" />
            <argument type="service" id="sarissaops_enviatodo.repository.shipment" />
            <argument type="service" id="logger" />
            <tag name="kernel.event_listener" event="workflow.sylius_order_payment.completed.pay" method="__invoke" />
        </service>

        <service id="sarissaops_enviatodo.controller.shop.quote" class="SarissaOps\SyliusEnviatodoPlugin\Controller\Shop\QuoteController" public="true">
            <argument type="service" id="sarissaops_enviatodo.component_calculator" />
            <argument type="service" id="security.csrf.token_manager" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoOrderManagerInterface" alias="sarissaops_enviatodo.order_manager" public="true" />
        <service id="SarissaOps\SyliusEnviatodoPlugin\Repository\EnviatodoShipmentRepositoryInterface" alias="sarissaops_enviatodo.repository.shipment" public="true" />

        <service id="sarissaops_enviatodo.address_api" class="SarissaOps\Enviatodo\Api\AddressApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="address" />
        </service>

        <service id="sarissaops_enviatodo.package_api" class="SarissaOps\Enviatodo\Api\PackageApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="package" />
        </service>

        <service id="sarissaops_enviatodo.parcel_api" class="SarissaOps\Enviatodo\Api\ParcelApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="parcel" />
        </service>

        <service id="sarissaops_enviatodo.catalog_api" class="SarissaOps\Enviatodo\Api\CatalogApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="catalog" />
        </service>

        <service id="sarissaops_enviatodo.address_book" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoAddressBook">
            <argument type="service" id="sarissaops_enviatodo.address_api" />
            <argument type="service" id="logger" />
        </service>

        <service id="sarissaops_enviatodo.package_catalog" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoPackageCatalog">
            <argument type="service" id="sarissaops_enviatodo.package_api" />
            <argument type="service" id="logger" />
        </service>

        <service id="sarissaops_enviatodo.carrier_catalog" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoCarrierCatalog">
            <argument type="service" id="sarissaops_enviatodo.parcel_api" />
            <argument type="service" id="sarissaops_enviatodo.catalog_api" />
        </service>

        <service id="sarissaops_enviatodo.checkout_defaults" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoCheckoutDefaults">
            <argument type="service" id="sarissaops_enviatodo.address_book" />
            <argument type="service" id="sarissaops_enviatodo.package_catalog" />
            <argument>%sarissa_ops_sylius_enviatodo.origin_address_id%</argument>
            <argument>%sarissa_ops_sylius_enviatodo.default_package_id%</argument>
        </service>

        <service id="sarissaops_enviatodo.controller.admin.address" class="SarissaOps\SyliusEnviatodoPlugin\Controller\Admin\AddressController" public="true">
            <argument type="service" id="sarissaops_enviatodo.address_book" />
            <argument type="service" id="security.csrf.token_manager" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="sarissaops_enviatodo.controller.admin.package" class="SarissaOps\SyliusEnviatodoPlugin\Controller\Admin\PackageController" public="true">
            <argument type="service" id="sarissaops_enviatodo.package_catalog" />
            <argument type="service" id="security.csrf.token_manager" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="sarissaops_enviatodo.controller.admin.carrier" class="SarissaOps\SyliusEnviatodoPlugin\Controller\Admin\CarrierController" public="true">
            <argument type="service" id="sarissaops_enviatodo.carrier_catalog" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="sarissaops_enviatodo.guide_api" class="SarissaOps\Enviatodo\Api\GuideApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="guide" />
        </service>

        <service id="sarissaops_enviatodo.label_service" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoLabelService">
            <argument type="service" id="sarissaops_enviatodo.guide_api" />
        </service>

        <service id="sarissaops_enviatodo.shipment_canceller" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\ShipmentCanceller">
            <argument type="service" id="sarissaops_enviatodo.order_api" />
            <argument type="service" id="logger" />
        </service>

        <service id="sarissaops_enviatodo.controller.admin.shipment_bulk" class="SarissaOps\SyliusEnviatodoPlugin\Controller\Admin\ShipmentBulkController" public="true">
            <argument type="service" id="sarissaops_enviatodo.label_service" />
            <argument type="service" id="sarissaops_enviatodo.repository.shipment" />
            <argument type="service" id="security.csrf.token_manager" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="sarissaops_enviatodo.twig.admin" class="SarissaOps\SyliusEnviatodoPlugin\Twig\EnviatodoAdminExtension">
            <argument type="service" id="sarissaops_enviatodo.repository.shipment" />
            <tag name="twig.extension" />
        </service>

        <service id="sarissaops_enviatodo.pickup_api" class="SarissaOps\Enviatodo\Api\PickupApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="pickup" />
        </service>

        <service id="sarissaops_enviatodo.pickup_scheduler" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoPickupScheduler">
            <argument type="service" id="sarissaops_enviatodo.pickup_api" />
            <argument type="service" id="logger" />
            <argument>%sarissa_ops_sylius_enviatodo.pickup_auto_schedule%</argument>
        </service>

        <service id="sarissaops_enviatodo.controller.admin.pickup" class="SarissaOps\SyliusEnviatodoPlugin\Controller\Admin\PickupController" public="true">
            <argument type="service" id="sarissaops_enviatodo.pickup_scheduler" />
            <argument type="service" id="security.csrf.token_manager" />
            <tag name="controller.service_arguments" />
        </service>
    </services>
</container>
