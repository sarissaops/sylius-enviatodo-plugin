<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <imports>
        <import resource="services/**" />
    </imports>

    <services>
        <service id="sarissaops_enviatodo.provider_map" class="SarissaOps\SyliusEnviatodoPlugin\Component\Shipping\ProviderMap">
            <argument>%sarissa_ops_sylius_enviatodo.provider_map%</argument>
        </service>

        <service id="sarissaops_enviatodo.quote_api" class="SarissaOps\Enviatodo\Api\QuoteApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="quote" />
        </service>

        <service id="sarissaops_enviatodo.zip_code_api" class="SarissaOps\Enviatodo\Api\ZipCodeApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="zipCode" />
        </service>

        <service id="sarissaops_enviatodo.component_calculator" class="SarissaOps\SyliusEnviatodoPlugin\Component\Shipping\Calculator\EnviatodoCalculator">
            <argument type="service" id="sarissaops_enviatodo.quote_api" />
        </service>

        <service id="sarissaops_enviatodo.shipping_calculator" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoShippingCalculator">
            <argument type="service" id="sarissaops_enviatodo.component_calculator" />
            <argument type="service" id="sarissaops_enviatodo.provider_map" />
            <tag name="sylius.shipping_calculator" calculator="enviatodo" label="Enviatodo (live rates)" />
        </service>

        <service id="sarissaops_enviatodo.validator.method_available" class="SarissaOps\SyliusEnviatodoPlugin\Validator\Constraints\EnviatodoMethodAvailableValidator">
            <argument type="service" id="sarissaops_enviatodo.zip_code_api" />
            <argument type="service" id="sarissaops_enviatodo.provider_map" />
            <tag name="validator.constraint_validator" />
        </service>

        <service id="sarissaops_enviatodo.order_api" class="SarissaOps\Enviatodo\Api\OrderApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="order" />
        </service>

        <service id="sarissaops_enviatodo.balance_api" class="SarissaOps\Enviatodo\Api\BalanceApi">
            <factory service="SarissaOps\Enviatodo\Enviatodo" method="balance" />
        </service>

        <service id="sarissaops_enviatodo.repository.shipment" class="SarissaOps\SyliusEnviatodoPlugin\Repository\EnviatodoShipmentRepository">
            <argument type="service" id="doctrine" />
        </service>

        <service id="sarissaops_enviatodo.order_manager" class="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoOrderManager">
            <argument type="service" id="sarissaops_enviatodo.order_api" />
            <argument type="service" id="sarissaops_enviatodo.balance_api" />
            <argument type="service" id="sarissaops_enviatodo.provider_map" />
            <argument type="service" id="doctrine" />
            <argument type="service" id="logger" />
            <argument>%sarissa_ops_sylius_enviatodo.insurance%</argument>
        </service>

        <service id="sarissaops_enviatodo.listener.order_paid" class="SarissaOps\SyliusEnviatodoPlugin\EventListener\OrderPaidListener">
            <argument type="service" id="sarissaops_enviatodo.order_manager" />
            <argument type="service" id="sarissaops_enviatodo.provider_map" />
            <argument type="service" id="sarissaops_enviatodo.repository.shipment" />
            <argument type="service" id="logger" />
            <tag name="kernel.event_listener" event="workflow.sylius_order_payment.completed.pay" method="__invoke" />
        </service>

        <service id="sarissaops_enviatodo.controller.shop.quote" class="SarissaOps\SyliusEnviatodoPlugin\Controller\Shop\QuoteController" public="true">
            <argument type="service" id="sarissaops_enviatodo.component_calculator" />
            <argument type="service" id="security.csrf.token_manager" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="SarissaOps\SyliusEnviatodoPlugin\Shipping\EnviatodoOrderManagerInterface" alias="sarissaops_enviatodo.order_manager" public="true" />
        <service id="SarissaOps\SyliusEnviatodoPlugin\Repository\EnviatodoShipmentRepositoryInterface" alias="sarissaops_enviatodo.repository.shipment" public="true" />
    </services>
</container>
