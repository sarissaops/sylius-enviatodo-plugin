<?xml version="1.0" encoding="UTF-8" ?>

<!-- UI-only wiring. Loaded by the extension only when a Twig extension is
     registered, so headless applications boot without twig/twig installed. -->
<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="sarissaops_enviatodo.twig.admin" class="SarissaOps\SyliusEnviatodoPlugin\Twig\EnviatodoAdminExtension">
            <argument type="service" id="sarissaops_enviatodo.repository.shipment" />
            <tag name="twig.extension" />
        </service>
    </services>
</container>
